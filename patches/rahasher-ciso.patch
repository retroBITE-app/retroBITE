diff --git a/Makefile.RAHasher b/Makefile.RAHasher
index ec55e39..8c700f2 100644
--- a/Makefile.RAHasher
+++ b/Makefile.RAHasher
@@ -46,6 +46,15 @@ ifdef HAVE_CHD
           src/HashCHD.o
 endif
 
+# CSO/ZSO, through the zlib HAVE_CHD vendors and a static liblz4
+ifdef HAVE_CISO
