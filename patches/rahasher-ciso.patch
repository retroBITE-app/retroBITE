+  CXXFLAGS += -DHAVE_CISO
+  OBJS += src/ciso.o \
+          src/HashCISO.o
+  LDFLAGS += -l:liblz4.a
+endif
+
 all: $(OUTDIR)/RAHasher$(EXE)
 
 %.o: %.cpp
