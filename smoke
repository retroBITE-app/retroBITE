#!/usr/bin/env bash
# Start a web image the way an install does, and say whether it works.
#
#   ./smoke [tag]        retrobite/retrobite:<tag>, default develop
#
# The image must already be here: ./build without pushing loads it (:develop,
# or :<version> and :latest for a release). Nothing is pulled.
#
# Runs docker-compose.yml as it is — no .env, no share — in a project of its
# own on port 8181, and checks that the web container:
#
#   * comes up healthy, answers /up and serves its first page
#   * generates its application key into the state volume
#   * keeps that key when the container is recreated
#
# then removes the project and its volumes. Run it before pushing a release:
# an image that fails here would fail every install. The docker workflow's
# smoke job runs the same.

set -euo pipefail
cd "$(dirname "$0")"

TAG=${1:-develop}
PROJECT=retrobite-smoke
PORT=${SMOKE_PORT:-8181}

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# No .env: an install from the release's files may not have one, and this
# checkout's would carry development settings into the test.
compose() {
    RETROBITE_TAG=$TAG WEB_PORT=$PORT docker compose -p "$PROJECT" \
        --env-file /dev/null -f docker-compose.yml -f "$override" "$@"
}

# The key file, read inside the running web container.
app_key() {
    compose exec -T retrobite-web cat /app/storage/state/app.key 2>/dev/null || true
}

fail() {
    echo -e "${RED}$*${NC}" >&2
    compose logs retrobite-web >&2 || true
    exit 1
}

cleanup() {
    compose down -v --remove-orphans >/dev/null 2>&1 || true
    rm -rf "$games" "$override"
}

docker image inspect "retrobite/retrobite:$TAG" >/dev/null 2>&1 \
    || fail "No image retrobite/retrobite:$TAG here. Build it first: ./build"

# The library mount wants a folder; an empty one of its own. And the fixed
# container names in docker-compose.yml dropped, so an install already
# running on this machine is left alone.
games=$(mktemp -d)
override=$(mktemp)
export GAMES_PATH=$games
trap cleanup EXIT

cat > "$override" <<'YAML'
services:
  retrobite-web:
    container_name: !reset null
  retrobite-db:
    container_name: !reset null
YAML

echo -e "${YELLOW}> Starting retrobite/retrobite:$TAG on port $PORT${NC}"
compose up -d --pull never --wait --wait-timeout 300 retrobite-web retrobite-db \
    || fail "The stack did not come up healthy."

curl -fsS -o /dev/null "http://localhost:$PORT/up" || fail "/up did not answer."

# A real page, which /up is not: it starts a session and sets encrypted
# cookies, so it fails when the key is missing or unreadable.
curl -fsSL -o /dev/null "http://localhost:$PORT/" || fail "The first page did not load."

key=$(app_key)
[ -n "$key" ] || fail "No application key was generated in storage/state."

echo -e "${YELLOW}> Recreating the web container${NC}"
compose up -d --pull never --wait --wait-timeout 300 --force-recreate retrobite-web \
    || fail "The recreated container did not come up healthy."

[ "$(app_key)" = "$key" ] \
    || fail "The application key changed when the container was recreated."

curl -fsS -o /dev/null "http://localhost:$PORT/up" || fail "/up did not answer after recreating."

echo -e "${GREEN}> retrobite/retrobite:$TAG starts, answers, and keeps its key.${NC}"
