FROM composer:latest AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
# --no-scripts: package:discover needs artisan, which is not here yet.
# --ignore-platform-req=ext-intl: this stage only downloads packages, and the
# composer image has no intl. The runtime image does, which is where it matters.
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction \
    --ignore-platform-req=ext-intl

FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

COPY vite.config.js ./
COPY resources/ ./resources/
COPY --from=vendor /app/vendor/livewire/flux ./vendor/livewire/flux
COPY --from=vendor /app/vendor/laravel/framework/src/Illuminate/Pagination \
     ./vendor/laravel/framework/src/Illuminate/Pagination

RUN npm run build

# Stage 3: RAHasher, from rcheevos by way of RALibretro
#
# RetroAchievements identifies a game by a hash that is not an MD5 of the file:
# the iNES header comes off a NES rom, copier headers off a SNES one, and for a
# disc it is the primary executable named in SYSTEM.CNF that gets hashed rather
# than the disc. That logic lives in rcheevos, and reimplementing it would mean
# keeping a second copy of somebody else's format knowledge in step with theirs.
#
# There is no official Linux binary, so it is built here — on Alpine, because
# the runtime below is musl and a glibc build would not run on it.
FROM alpine:3.21 AS rahasher

RUN apk add --no-cache build-base git zlib-dev zlib-static

# Pinned. A hasher that quietly changed what it returned between deploys would
# invalidate the cached hash on every file in the library.
ARG RALIBRETRO_TAG=1.8.4

# Four deviations from the documented build, each for a reason:
#
#  * Only three submodules. The full set pulls SDL2, which RAHasher does not
#    link and which is most of the download.
#  * Two includes added to src/Util.h. It uses time_t and FILE without
#    including <ctime> or <cstdio>; glibc drags both in through <string> and
#    musl does not, so upstream compiles on Debian and not here.
#  * RA_BuildVer.h written by hand. The rule that generates it runs a script
#    from the RAInterface submodule, which is otherwise not needed; the header
#    defines one version string.
#  * -DZ_HAVE_UNISTD_H through CC. libchdr vendors zlib with the unistd guard
#    off, so gzlib.c calls lseek() with no declaration. It rides on CC rather
#    than CFLAGS because Makefile.common assigns CFLAGS outright and overriding
#    it would drop every include path.
RUN git clone --depth 1 --branch "$RALIBRETRO_TAG" \
        https://github.com/RetroAchievements/RALibretro.git /src \
    && cd /src \
    && git submodule update --init --depth 1 src/miniz src/rcheevos src/libchdr \
    && sed -i '/#include <stddef.h>/a #include <cstdio>\n#include <ctime>' src/Util.h \
    && printf '#define RA_LIBRETRO_VERSION_SHORT "%s"\n' "$RALIBRETRO_TAG" > src/RA_BuildVer.h \
    && make -f Makefile.RAHasher HAVE_CHD=1 -j"$(nproc)" CC="gcc -DZ_HAVE_UNISTD_H" \
    && cp "$(find /src -type f -name RAHasher -perm -u+x | head -n 1)" /usr/local/bin/RAHasher \
    && /usr/local/bin/RAHasher | head -n 1

# Stage 4: PHP-FPM + nginx runtime
FROM php:8.5-fpm-alpine AS runner

# php:8.5-fpm-alpine already has pdo_sqlite, sqlite3, OPcache and the whole
# ctype/curl/dom/fileinfo/filter/hash/mbstring/openssl/pcre/pdo/session/
# tokenizer/xml set Laravel's requirements list names. Passing an already
# compiled extension to docker-php-ext-install builds no module and fails the
# copy, so those must be left off the list below.
#
# What is added here is everything else Laravel's own Docker image (Sail)
# ships, so a feature that needs an extension is never a rebuild away.
# Deliberately not included: xdebug and pcov (development and coverage tooling
# that slows a runtime image down), swoole (an alternative server, not
# compatible with the php-fpm model here), imagick (~150 MB of ImageMagick for
# what gd already covers) and mongodb and imap (no such database here, and imap
# left PHP core after 8.3).
#
# Runtime libraries must survive .build-deps being removed: an extension links
# against them at build time and fails at *runtime* without them, so a missing
# one shows up as a 500 rather than a failed build. That is why icu-libs,
# libpng, libjpeg-turbo, freetype, libpq, libldap and libmemcached-libs are in
# the first list rather than the virtual one.
#
# unzip and git are for Composer's dist path.
RUN apk add --no-cache \
        nginx su-exec unzip git \
        libzip icu-libs libpng libjpeg-turbo freetype libpq libldap \
        libmemcached-libs gettext libwebp \
        # For the per-console toolboxes in app/Scripts. Alpine's shell is ash
        # and carries no `strings`; reading a PS2 disc's serial needs both, and
        # without them the export fails at runtime as exit 127.
        bash binutils \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS libzip-dev icu-dev libpng-dev libjpeg-turbo-dev \
        freetype-dev postgresql-dev openldap-dev libmemcached-dev zlib-dev \
        gettext-dev libxml2-dev linux-headers libwebp-dev \
    # gd without this builds silently without JPEG support and only fatals when
    # something calls imagecreatefromjpeg().
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath calendar exif ftp gd gettext intl ldap pcntl pdo_mysql \
        pdo_pgsql pgsql shmop soap sockets sysvmsg sysvsem sysvshm zip \
    # PECL rather than bundled. igbinary and msgpack are the serializers redis
    # and memcached use, so they are built first.
    && pecl install igbinary msgpack redis \
    && docker-php-ext-enable igbinary msgpack redis \
    # memcached asks for the libmemcached path unless it is answered; the empty
    # line takes the default.
    && yes '' | pecl install memcached \
    && docker-php-ext-enable memcached \
    && apk del .build-deps \
    && rm -rf /tmp/pear

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY --from=vendor /app/vendor ./vendor
COPY . .
RUN composer dump-autoload --optimize --no-dev

COPY --from=frontend-builder /app/public/build ./public/build

# On PATH, which is where config/retroachievements.php looks by default.
COPY --from=rahasher /usr/local/bin/RAHasher /usr/local/bin/RAHasher

# Nginx server block
COPY docker/web/nginx.conf /etc/nginx/http.d/default.conf

# PHP config overrides
COPY docker/web/zz-env.conf /usr/local/etc/php-fpm.d/zz-env.conf
COPY docker/web/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/web/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

COPY docker/web/user-setup.sh /usr/local/bin/user-setup.sh
COPY docker/web/queue-workers.sh /usr/local/bin/queue-workers.sh
COPY docker/web/reverb.sh /usr/local/bin/reverb.sh
COPY docker/web/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/user-setup.sh /usr/local/bin/queue-workers.sh /usr/local/bin/reverb.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
