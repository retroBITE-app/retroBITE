# Web UI login. CHANGE THESE — the defaults are published in this file.
AUTH_USER=retrobite
AUTH_PASS=retrobite

# Network
HOST_IP=192.168.50.250

# Web
# Renders stack traces in the browser. Leave unset in production.
# APP_DEBUG=true
# WEB_PORT=80
# Vite HMR dev server port — change it if another project already owns 5173
# VITE_PORT=5173
# Largest assembled upload, in bytes. Default 64 GiB.
# UPLOAD_MAX_BYTES=68719476736
# GAMES_PATH=/games
# DB_PATH=/data/retrobite.db

# ScreenScraper.fr metadata provider — https://www.screenscraper.fr
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
SCREENSCRAPER_CONNECT_TIMEOUT=15
SCREENSCRAPER_TIMEOUT=45