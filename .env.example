# retroBITE — the settings worth changing.
#
# Save this file as .env beside docker-compose.yml, or enter the same names in
# your container manager's variables (Portainer, Dockhand, Synology, Unraid,
# TrueNAS). Everything left out takes the default shown. The full list, with
# what each one does, is docs/configuration.md:
# https://github.com/retroBITE-app/retroBITE/blob/develop/docs/configuration.md
#
# There is no APP_KEY to generate: retroBITE makes one on its first start and
# keeps it in the retrobite-state volume.

# ── Change these before the first start ─────────────────────────────────────

# The account consoles use for SMB and FTP. Anyone on your network who knows
# it can read and write the library.
AUTH_USER=retrobite
AUTH_PASS=change-me

# The database's passwords. Read once, when the database is created: change
# them now, not after the first start.
DB_PASSWORD=change-me-too
DB_ROOT_PASSWORD=change-me-as-well

# Where your ROM library is on this machine, one folder per console inside it.
# A NAS path such as /volume1/games (Synology) or /mnt/user/games (Unraid).
GAMES_PATH=./games

# ── Usually worth setting ───────────────────────────────────────────────────

# This machine's address on your LAN, e.g. 192.168.1.20. The address consoles
# connect to, and what the dashboard checks SMB and FTP against.
HOST_IP=

# Your time zone, e.g. Europe/Stockholm: the times retroBITE shows and when its
# nightly jobs run.
APP_TIMEZONE=UTC

# The port the web interface answers on: http://<HOST_IP>:81
WEB_PORT=81

# Which images to run. Left unset, develop: the newest pre-release. A version
# such as 20261006-BETA stays on it; latest follows full releases, once there
# is one.
# RETROBITE_TAG=develop

# ── Optional ────────────────────────────────────────────────────────────────

# Keep these on folders of your own instead of Docker volumes, to back them up
# with the rest of the NAS. Each but DOCS_PATH (./docs) defaults to a volume.
# DB_PATH=/volume1/docker/retrobite/db
# MEDIA_PATH=/volume1/docker/retrobite/media
# STATE_PATH=/volume1/docker/retrobite/state
# DOCS_PATH=/volume1/docker/retrobite/docs

# Console folders created in the library, and those with an SMB share of their
# own (what Open PS2 Loader connects to).
# GAME_FOLDERS=ps2 ps3 gc wii xbox dreamcast
# SMB_SHARES=ps2 gc wii

# ps3netsrv, for webMAN MOD on a PS3: port 38008, serving the ps3 folder. It
# has no login, so limit it to your network, or turn it off.
# PS3NETSRV=true
# PS3NETSRV_WHITELIST=192.168.1.*

# Behind a reverse proxy serving https: the proxies to believe, or *.
# TRUSTED_PROXIES=*
# APP_URL=https://retrobite.example.lan

# The share on an address of its own (docker-compose.macvlan.yml), for a NAS
# whose own file sharing holds ports 445, 139 and 21.
# SHARE_IP=192.168.1.250
# SHARE_SUBNET=192.168.1.0/24
# SHARE_GATEWAY=192.168.1.1
# SHARE_PARENT=eth0
