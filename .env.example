APP_NAME=retroBITE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# SMB/FTP credentials for the share container. One account serves both.
AUTH_USER=retrobite
AUTH_PASS=retrobite
# Your machine's LAN IP. vsftpd advertises it for passive-mode data connections,
# so "localhost" will not work for a console on the network.
#
# Leave blank and the share container derives it from its default route on every
# start — which is what you want on a laptop that changes networks. Set it
# explicitly to pin a particular interface on a multi-homed host.
#
# The web container cannot detect it (it is on the bridge network), so set this
# if the dashboard's SMB/FTP status is to be accurate.
HOST_IP=

# Where the ROM library lives on the host. Mounted into both containers and
# exported as /games over SMB and FTP. Defaults to ./games inside the project.
GAMES_PATH=

# Where the markdown knowledge base lives on the host. Mounted into the web
# container, defaulting to ./storage/app/docs inside the project. The mount is
# what makes it survive `docker compose down`: everything else under
# storage/app lives in the container's writable layer.
DOCS_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Proxies whose X-Forwarded-* headers are believed, comma-separated, or * for
# any. Needed behind a reverse proxy that serves https, or links come out as
# http:// and the browser blocks them. Local development trusts any by default.
# TRUSTED_PROXIES=

# Laravel Debugbar, a dev dependency: on whenever APP_DEBUG is, and absent
# from the production image, which installs with --no-dev. Set false to hide it
# while keeping debug errors.
# DEBUGBAR_ENABLED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=retrobite-db
DB_PORT=3306
DB_DATABASE=retrobite
DB_USERNAME=retrobite
DB_PASSWORD=retrobite
# Only the mariadb container reads this one.
DB_ROOT_PASSWORD=retrobite

# Host-side `php artisan` cannot resolve the hostname "retrobite-db", which only exists
# inside the compose network. Point it at the published port instead:
#   DB_HOST=127.0.0.1 DB_PORT=3307 php artisan migrate
# The dev compose publishes 3307 by default; override with DB_PORT_HOST.
# DB_PORT_HOST=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live updates over Laravel Reverb, run inside the web container. When these
# are unset the entrypoint generates keys once into storage/framework/
# reverb.json, and the browser reads them from the page, so nothing needs
# filling in. Set them to pin them.
# Reverb listens on 127.0.0.1:8080 and is reached through nginx at /app/, over
# plain http — see docs/adr/0002-live-updates-over-reverb.md.
BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Queue workers per queue, read by the container's entrypoint at start. One
# each unless set here; 0 starts none. Media and hash are the ones worth
# raising on a machine with the room. The scraper gains speed up to
# the threads Settings → ScreenScraper shows for your account (1 on a plain
# account, 6 on Gold); past that, workers wait for a free thread.
# QUEUE_WORKERS_SCRAPER=1       # identification and ratings
# QUEUE_WORKERS_MEDIA=1         # artwork, scans, loader exports
# QUEUE_WORKERS_THUMBNAILS=1    # cover thumbnails, CPU bound
# QUEUE_WORKERS_RA=1            # RetroAchievements identification and sets
# QUEUE_WORKERS_RA_PROGRESS=1   # RetroAchievements unlocks
# QUEUE_WORKERS_HASH=1          # checksums and RA hashes, disk bound

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ScreenScraper
# SCREENSCRAPER_CONNECT_TIMEOUT=15
# SCREENSCRAPER_TIMEOUT=90

# RetroAchievements
# RETROACHIEVEMENTS_CONNECT_TIMEOUT=15
# RETROACHIEVEMENTS_TIMEOUT=180
# RA_HASHER_PATH=/usr/local/bin/RAHasher
# RA_HASHER_TIMEOUT=1800
