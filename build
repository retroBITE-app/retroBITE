#!/usr/bin/env bash
# Build retroBITE's two images and, when asked, push them to Docker Hub.
#
#   ./build develop [--version 20260930-ALPHA]
#                        a pre-release: :<version> and :develop. With no
#                        version and no tag on this commit, :develop and
#                        :develop-<commit>, to try something out
#   ./build master [--version 20260930]
#                        a release: :<version> and :latest
#   ./build --only web|share      one of the two images
#   ./build -y | --yes            push without asking, as CI does
#   ./build --digest-dir DIR      CI: push one platform untagged, by digest,
#                                 and note the digest in DIR
#   ./build --merge DIR           CI: tag the digests noted in DIR as one
#                                 multi-platform image, building nothing
#
# A version is the release's tag, a date with an optional suffix: 20260930,
# 20260930-ALPHA, 20260930-PREALPHA. Left out, it is read off the tag this
# commit carries. Whether a release is develop or master is the release's own
# choice — pre-release or not — never read off the suffix.
#
# Pushed, an image is built for every platform in PLATFORMS (amd64 and arm64)
# in one go, which is why the question comes before the build: a multi-platform
# image cannot be loaded into the local daemon and pushed afterwards. Not
# pushed, it is built for this machine only and loaded, to try out locally.
# CI builds each platform on a runner of its own (PLATFORMS=linux/arm64
# --digest-dir), then joins them with --merge, so nothing runs under emulation.
#
# The web UI is retrobite/retrobite (Dockerfile.web), the SMB/FTP share
# retrobite/share (Dockerfile). The CI job is .github/workflows/docker.yml.

set -euo pipefail
cd "$(dirname "$0")"

YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color

WEB_IMAGE=${WEB_IMAGE:-retrobite/retrobite}
SHARE_IMAGE=${SHARE_IMAGE:-retrobite/share}
PLATFORMS=${PLATFORMS:-linux/amd64,linux/arm64}
# "registry" (as CI sets it): layers kept on Docker Hub as :buildcache between
# runs, so the tools compiled for arm64 under emulation are not compiled again
# on every push. Read on every build, written only by a pushed one.
BUILD_CACHE=${BUILD_CACHE:-}
SOURCE_URL=${SOURCE_URL:-https://github.com/retroBITE-app/retroBITE}

say() {
    echo -e "${YELLOW}> $*${NC}"
}

fail() {
    echo -e "${RED}$*${NC}" >&2
    exit 1
}

usage() {
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

channel=develop
version=""
only=""
auto_yes=0
digest_dir=""
merge_dir=""

while [ $# -gt 0 ]; do
    case "$1" in
        develop | master) channel=$1 ;;
        --version) version=${2:-}; shift ;;
        --version=*) version=${1#*=} ;;
        --only) only=${2:-}; shift ;;
        --only=*) only=${1#*=} ;;
        -y | --yes) auto_yes=1 ;;
        --digest-dir) digest_dir=${2:-}; shift ;;
        --digest-dir=*) digest_dir=${1#*=} ;;
        --merge) merge_dir=${2:-}; shift ;;
        --merge=*) merge_dir=${1#*=} ;;
        -h | --help) usage; exit 0 ;;
        *) fail "Unknown argument: $1 (see ./build --help)" ;;
    esac
    shift
done

case "$only" in
    "" | web | share) ;;
    *) fail "--only takes web or share, not: $only" ;;
esac

if [ -n "$digest_dir" ] && { [[ $PLATFORMS == *,* ]] || [ $auto_yes -ne 1 ]; }; then
    fail "--digest-dir pushes one platform: pass --yes and set PLATFORMS to one, not $PLATFORMS"
fi

commit=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

if [ -z "$version" ]; then
    version=$(git describe --tags --exact-match 2>/dev/null || true)
fi

if [ -n "$version" ] && ! [[ $version =~ ^[0-9]{8}(-[0-9A-Za-z]+)?$ ]]; then
    fail "Not a version: $version (expected a date, 20260930, or 20260930-ALPHA)"
fi

if [ -z "$version" ] && [ "$channel" = master ]; then
    fail "A master build needs a version: build a release's tag, or pass --version 20260930."
fi

# Every tag one image gets: the release's own, and the channel's moving one.
# A develop build of no release is named after its commit instead.
tags_for() {
    local image=$1
    local moving=latest

    [ "$channel" = develop ] && moving=develop

    if [ -n "$version" ]; then
        echo "$image:$version" "$image:$moving"
    else
        echo "$image:develop" "$image:develop-$commit"
    fi
}

# Join the per-platform digests noted in $merge_dir into one tagged image. Every
# platform in PLATFORMS must have one: a missing build fails here, not later.
merge_image() {
    local image=$1 name=${1##*/}
    local args=(buildx imagetools create)
    local digests=("$merge_dir/$name"-*)
    local expected found=0

    expected=$(tr ',' '\n' <<< "$PLATFORMS" | wc -l)
    [ -e "${digests[0]}" ] && found=${#digests[@]}

    if [ "$found" -ne "$expected" ]; then
        fail "$image: expected $expected digests in $merge_dir, found $found"
    fi

    for tag in $(tags_for "$image"); do
        args+=(-t "$tag")
    done

    for file in "${digests[@]}"; do
        args+=("$image@$(cat "$file")")
    done

    say "Tagging $image: $(tags_for "$image")"
    docker "${args[@]}"
}

if [ -n "$merge_dir" ]; then
    [ "$only" != share ] && merge_image "$WEB_IMAGE"
    [ "$only" != web ] && merge_image "$SHARE_IMAGE"

    say "Completed!"
    exit 0
fi

if [ $auto_yes -eq 1 ]; then
    REPLY="y"
elif [ -t 0 ]; then
    read -p $'\033[1;33mPush to Docker Hub once built? [y/N] \033[0m' -n 1 -r
    echo # Move to a new line
else
    REPLY="n"
fi

push=0
[[ $REPLY =~ ^[Yy]$ ]] && push=1

# The plain docker driver builds for one platform only; a pushed build needs
# one that does several. awk reads to the end: quitting at the first match
# breaks the pipe under buildx, which exits 255 and, with pipefail, the script.
if [ $push -eq 1 ]; then
    driver=$(docker buildx inspect 2>/dev/null | awk '/^Driver:/ && !found { print $2; found = 1 }')

    if [ "$driver" = docker ]; then
        say "Setting up a multi-platform builder..."
        docker buildx use retrobite 2>/dev/null || docker buildx create --name retrobite --use >/dev/null
    fi
fi

build_image() {
    local image=$1 dockerfile=$2
    local args=(buildx build -f "$dockerfile")
    local cache=$image:buildcache

    # A digest build is untagged: --merge tags it once every platform is in.
    if [ -z "$digest_dir" ]; then
        for tag in $(tags_for "$image"); do
            args+=(-t "$tag")
        done
    fi

    args+=(
        --label "org.opencontainers.image.source=$SOURCE_URL"
        --label "org.opencontainers.image.revision=$(git rev-parse HEAD 2>/dev/null || echo unknown)"
        --label "org.opencontainers.image.version=${version:-develop-$commit}"
        --label "org.opencontainers.image.created=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    )

    # A platform built alone (as CI does) keeps a cache of its own, or each run
    # would overwrite the other platform's layers. It still reads the shared
    # one, which a multi-platform build writes with both platforms in it.
    if [ "$BUILD_CACHE" = registry ]; then
        args+=(--cache-from "type=registry,ref=$cache")

        if [[ $PLATFORMS != *,* ]]; then
            cache=$cache-${PLATFORMS##*/}
            args+=(--cache-from "type=registry,ref=$cache")
        fi

        [ $push -eq 1 ] && args+=(--cache-to "type=registry,ref=$cache,mode=max")
    fi

    if [ -n "$digest_dir" ]; then
        build_digest "$image" "${args[@]}"
        return
    fi

    if [ $push -eq 1 ]; then
        say "Building and pushing $image for $PLATFORMS: $(tags_for "$image")"
        args+=(--platform "$PLATFORMS" --push)
    else
        say "Building $image for this machine: $(tags_for "$image")"
        args+=(--load)
    fi

    docker "${args[@]}" .
}

# Push one platform by digest alone and note it as $digest_dir/<name>-<arch>,
# the file --merge reads.
build_digest() {
    local image=$1 name=${1##*/}
    shift
    local metadata digest

    metadata=$(mktemp)
    mkdir -p "$digest_dir"

    say "Building and pushing $image for $PLATFORMS, by digest"
    docker "$@" --platform "$PLATFORMS" --metadata-file "$metadata" \
        --output "type=image,name=$image,push-by-digest=true,name-canonical=true,push=true" .

    digest=$(jq -r '."containerimage.digest"' "$metadata")
    rm -f "$metadata"

    [[ $digest == sha256:* ]] || fail "$image: no digest in the build's metadata"
    echo "$digest" > "$digest_dir/$name-${PLATFORMS##*/}"
}

if [ "$only" != share ]; then
    build_image "$WEB_IMAGE" Dockerfile.web
fi

if [ "$only" != web ]; then
    build_image "$SHARE_IMAGE" Dockerfile
fi

say "Completed!"
