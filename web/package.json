{
  "name": "retrobite-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint resources/js eslint.config.js",
    "lint:fix": "eslint resources/js eslint.config.js --fix",
    "format": "prettier --write \"resources/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@inertiajs/vue3": "^2.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.4"
  }
}
