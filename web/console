#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * retroBITE CLI. Work that must not run on the request path lives here.
 *
 * Usage: php console <command> [args]
 */

use App\Database\Bootstrap;
use App\Services\LibraryScanService;
use App\Support\Console as ConsoleMeta;
use Illuminate\Container\Container;

require __DIR__ . '/vendor/autoload.php';

/** @var Container $container */
$container = require __DIR__ . '/bootstrap/container.php';
require __DIR__ . '/bootstrap/database.php';

/**
 * Print a line to stdout.
 */
function line(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

/**
 * Print a line to stderr and yield a failing exit code.
 */
function fail(string $message): int
{
    fwrite(STDERR, $message . PHP_EOL);

    return 1;
}

/**
 * Apply pending migrations and seed the initial user.
 */
function commandMigrate(): int
{
    Bootstrap::prepare();
    line('Database is up to date.');

    return 0;
}

/**
 * Rescan one console's directory, or every installed console.
 */
function commandScan(Container $container, ?string $consoleKey): int
{
    $targets = $consoleKey === null
        ? ConsoleMeta::allInstalled()->all()
        : array_values(array_filter([ConsoleMeta::tryFrom($consoleKey)]));

    if ($targets === []) {
        return fail($consoleKey === null ? 'No installed consoles.' : "Unknown console: {$consoleKey}");
    }

    $scanner = $container->make(LibraryScanService::class);

    foreach ($targets as $console) {
        $indexed = $scanner->index($console);

        // No execution limit out here, so the CLI hashes the whole backlog in one
        // pass rather than in the batches the web UI has to poll for.
        $hashed = $scanner->hashPending($console, budgetSeconds: 0.0);

        line(sprintf(
            '%-12s %d found, %d pruned, %d hashed',
            $console->key,
            $indexed['found'],
            $indexed['pruned'],
            $hashed['hashed'],
        ));
    }

    return 0;
}

/**
 * Emit resources/js/routes.ts from config/routes.php so the frontend stops
 * hand-writing URLs.
 */
function commandRoutesTs(): int
{
    $paths = App\Support\Routes::all()
        ->map(fn(array $route, string $name) => sprintf("  '%s': '%s',", $name, $route['path']))
        ->values()
        ->all();

    $lines = [
        '/**',
        ' * Route paths, generated from config/routes.php by `php console routes:ts`.',
        ' * Do not edit by hand — edit the PHP map and regenerate.',
        ' */',
        'const PATHS = {',
        ...$paths,
        '} as const',
        '',
        'export type RouteName = keyof typeof PATHS',
        '',
        '/**',
        ' * Build a URL for a named route, substituting each placeholder. A catch-all',
        ' * placeholder keeps its separators; every other value is one segment.',
        ' */',
        'export function route(name: RouteName, params: Record<string, string | number> = {}): string {',
        '  let url: string = PATHS[name]',
        '',
        '  for (const [key, value] of Object.entries(params)) {',
        '    url = url.replace(`{${key}:.+}`, String(value).split(\'/\').map(encodeURIComponent).join(\'/\'))',
        '    url = url.replace(`{${key}}`, encodeURIComponent(String(value)))',
        '  }',
        '',
        '  if (url.includes(\'{\')) {',
        '    throw new Error(`Route ${name} is missing a parameter: ${url}`)',
        '  }',
        '',
        '  return url',
        '}',
        '',
    ];

    file_put_contents(__DIR__ . '/resources/js/routes.ts', implode("\n", $lines));

    line('Wrote resources/js/routes.ts');

    return 0;
}

/**
 * List the available commands.
 */
function commandHelp(): int
{
    line('retroBITE CLI');
    line();
    line('  migrate            Apply pending migrations and seed the first user');
    line('  scan [console]     Rescan a console directory, or all installed consoles');
    line('  routes:ts          Regenerate resources/js/routes.ts from config/routes.php');
    line('  help               Show this message');

    return 0;
}

$command = $argv[1] ?? 'help';

exit(match ($command) {
    'migrate' => commandMigrate(),
    'scan'      => commandScan($container, $argv[2] ?? null),
    'routes:ts' => commandRoutesTs(),
    'help'    => commandHelp(),
    default   => fail("Unknown command: {$command}"),
});
