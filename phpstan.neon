includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # The Livewire components that use these traits are single-file
        # components living in resources/views/livewire/*.blade.php, which is
        # not an analysed path — PHPStan cannot see the `use` statements inside
        # an anonymous class in a Blade file, so it reports the traits as dead.
        # They are not: see settings/security.blade.php, delete-user-form.blade.php,
        # profile.blade.php, and tools/conversion.blade.php and
        # tools/decrypt.blade.php for PicksConsoleTab.
        -
            message: '#^Trait App\\Concerns\\((Password|Profile)ValidationRules|PicksConsoleTab) is used zero times and is not analysed\.$#'
            path: app/Concerns/*.php

        # A toolbox is resolved by ConsoleTools::for(), not constructed with
        # its console: tests/Unit does not boot the application, and `new PS2`
        # has to keep working without a container to read config from. PHP
        # allows a readonly property to be initialised anywhere in its
        # declaring class's scope, and for() is the only place that does it.
        #
        # The readonly is kept rather than dropped because it is the guard:
        # a binding that ever became a singleton would throw here on the
        # second resolve instead of quietly handing two callers one object.
        -
            identifier: property.uninitializedReadonly
            path: app/Tools/ConsoleTools.php
        -
            identifier: property.readOnlyAssignNotInConstructor
            path: app/Tools/ConsoleTools.php
