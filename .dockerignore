# Secrets. Without this, COPY . . bakes the live APP_KEY into every image layer.
.env
.env.*
!.env.example
C*E.md

# Rebuilt inside the image
vendor/
node_modules/

# Live data. The DB belongs on the /data volume, never in an image layer.
database/*.sqlite
database/*.sqlite-journal

# Runtime state
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/games/*
storage/app/docs/*
localtest/

# Not needed at runtime
tests/
.git
.gitignore
.gitattributes
.github/
.claude/
.agents/
.editorconfig
phpunit.xml
phpstan.neon
pint.json
*.md
retroBite.png
