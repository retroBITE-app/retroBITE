FROM php:8.4-fpm-alpine

RUN apk add --no-cache nginx sqlite sqlite-dev \
    && docker-php-ext-install pdo_sqlite

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app/web

# Nginx + PHP-FPM config (not volume-mounted, so bake them in)
COPY docker/web/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/web/zz-env.conf /usr/local/etc/php-fpm.d/zz-env.conf
COPY docker/web/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/web/entrypoint.dev.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
